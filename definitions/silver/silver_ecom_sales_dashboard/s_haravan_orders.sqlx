config {
  type: "incremental",
  schema: "silver_ecom_sales_dashboard",
  name: "s_haravan_orders",
  description: "Haravan don (cap don). Khu trung stg_haravan_orders: giu ban update_time moi nhat / (shop_id, order_id). Bo line_items. INCREMENTAL: chi quet ingest_dt 3 ngay gan nhat de giam doc raw GCS.",
  uniqueKey: ["shop_id", "order_id"],
  bigquery: {
    partitionBy: "DATE_TRUNC(create_time, MONTH)",
    clusterBy: ["shop_id"],
    updatePartitionFilter: "create_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 100 DAY)"
  },
  tags: ["silver", "haravan"]
}

SELECT * EXCEPT(line_items, _rn)
FROM (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY shop_id, order_id
      ORDER BY update_time DESC, _ingested_at DESC
    ) AS _rn
  FROM ${ref("stg_haravan_orders")}
  ${when(incremental(), `WHERE ingest_dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)`)}
)
WHERE _rn = 1
