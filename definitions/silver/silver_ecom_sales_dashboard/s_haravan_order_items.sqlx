config {
  type: "incremental",
  schema: "silver_ecom_sales_dashboard",
  name: "s_haravan_order_items",
  description: "Haravan chi tiết món. Khử trùng stg_haravan_order_items: giữ bản mới nhất / (shop_id, order_id, line_item_id). INCREMENTAL: chỉ quét ingest_dt mới để giảm đọc raw GCS.",
  uniqueKey: ["shop_id", "order_id", "line_item_id"],
  bigquery: {
    partitionBy: "DATE_TRUNC(order_update_time, MONTH)",
    clusterBy: ["shop_id"],
    updatePartitionFilter: "order_update_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 100 DAY)"
  },
  tags: ["silver", "haravan"]
}

SELECT * EXCEPT(_rn)
FROM (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY shop_id, order_id, line_item_id
      ORDER BY order_update_time DESC, _ingested_at DESC
    ) AS _rn
  FROM ${ref("stg_haravan_order_items")}
  ${when(incremental(), `WHERE ingest_dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)`)}
)
WHERE _rn = 1
