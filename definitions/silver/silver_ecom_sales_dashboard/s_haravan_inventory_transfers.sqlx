config {
  type: "table",
  schema: "silver_ecom_sales_dashboard",
  name: "s_haravan_inventory_transfers",
  description: "Haravan chuyển kho giữa chi nhánh (cấp phiếu). Rebuild từ snapshot ingest_dt mới nhất (nguồn là full refresh).",
  bigquery: {
    partitionBy: "DATE_TRUNC(create_time, MONTH)",
    clusterBy: ["shop_id", "from_location_id"]
  },
  tags: ["silver", "haravan", "haravan_inventory"]
}

SELECT * EXCEPT(line_items, _rn)
FROM (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY shop_id, transfer_id
      ORDER BY update_time DESC, _ingested_at DESC
    ) AS _rn
  FROM ${ref("stg_haravan_inventory_transfers")}
  WHERE ingest_dt = (SELECT MAX(ingest_dt) FROM ${ref("stg_haravan_inventory_transfers")})
)
WHERE _rn = 1
