config {
  type: "incremental",
  schema: "silver_ecom_sales_dashboard",
  name: "s_shopee_order_escrow",
  description: "Shopee escrow (P&L cấp đơn). Khử trùng stg_escrow: giữ bản ingest mới nhất / (shop_id, order_sn). INCREMENTAL: chỉ quét ingest_dt mới để giảm đọc raw GCS.",
  uniqueKey: ["shop_id", "order_sn"],
  bigquery: {
    partitionBy: "DATE_TRUNC(ingest_dt, MONTH)",
    clusterBy: ["shop_id"],
    updatePartitionFilter: "ingest_dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY)"
  },
  tags: ["silver", "shopee"]
}

SELECT * EXCEPT(_rn)
FROM (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY shop_id, order_sn
      ORDER BY _ingested_at DESC
    ) AS _rn
  FROM ${ref("stg_shopee_order_escrow")}
  ${when(incremental(), `WHERE ingest_dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)`)}
)
WHERE _rn = 1
