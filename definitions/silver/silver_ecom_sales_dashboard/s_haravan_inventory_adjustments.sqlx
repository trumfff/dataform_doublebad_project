config {
  type: "table",
  schema: "silver_ecom_sales_dashboard",
  name: "s_haravan_inventory_adjustments",
  description: "Haravan điều chỉnh kho (cấp phiếu). Nguồn là FULL SNAPSHOT mỗi ngày → chỉ đọc partition ingest_dt MỚI NHẤT rồi rebuild, KHÔNG merge tăng dần (merge sẽ đụng updatePartitionFilter vì 1 snapshot chứa bản ghi của mọi tháng). Chỉ quét ~1 partition staging/lần nên vẫn rẻ.",
  bigquery: {
    partitionBy: "DATE_TRUNC(create_time, MONTH)",
    clusterBy: ["shop_id", "location_id"]
  },
  tags: ["silver", "haravan", "haravan_inventory"]
}

SELECT * EXCEPT(line_items, _rn)
FROM (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY shop_id, adjustment_id
      ORDER BY update_time DESC, _ingested_at DESC
    ) AS _rn
  FROM ${ref("stg_haravan_inventory_adjustments")}
  WHERE ingest_dt = (SELECT MAX(ingest_dt) FROM ${ref("stg_haravan_inventory_adjustments")})
)
WHERE _rn = 1
