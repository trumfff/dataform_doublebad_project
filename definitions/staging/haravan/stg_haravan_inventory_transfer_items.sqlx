config {
  type: "view",
  schema: "stg_haravan",
  name: "stg_haravan_inventory_transfer_items",
  description: "Explode line_items chuyển kho → 1 dòng = 1 sản phẩm được chuyển. GIỮ mọi snapshot.",
  tags: ["staging", "haravan", "haravan_inventory"]
}

SELECT
  t.shop_id,
  t.ingest_dt,
  t.transfer_id,
  t.transfer_number,
  t.from_location_id,
  t.to_location_id,
  t.status,
  t.reason,
  t.tran_time,
  t.update_time                        AS transfer_update_time,
  CAST(i.id AS STRING)                 AS line_item_id,
  CAST(i.product_id AS STRING)         AS product_id,
  CAST(i.product_variant_id AS STRING) AS variant_id,
  i.sku,
  i.barcode,
  i.product_name,
  i.variant_title,
  CAST(i.quantity AS FLOAT64)          AS quantity,
  CAST(i.cost_amount AS FLOAT64)       AS cost_amount,
  t._ingested_at
FROM ${ref("stg_haravan_inventory_transfers")} t, UNNEST(t.line_items) AS i
