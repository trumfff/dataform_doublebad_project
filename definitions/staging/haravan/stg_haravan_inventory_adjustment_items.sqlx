config {
  type: "view",
  schema: "stg_haravan",
  name: "stg_haravan_inventory_adjustment_items",
  description: "Explode line_items điều chỉnh kho → 1 dòng = 1 sản phẩm bị điều chỉnh. GIỮ mọi snapshot.",
  tags: ["staging", "haravan", "haravan_inventory"]
}

SELECT
  a.shop_id,
  a.ingest_dt,
  a.adjustment_id,
  a.adjust_number,
  a.location_id,
  a.reason,
  a.tran_time,
  a.update_time                     AS adjustment_update_time,
  CAST(i.id AS STRING)              AS line_item_id,
  CAST(i.product_id AS STRING)      AS product_id,
  CAST(i.product_variant_id AS STRING) AS variant_id,
  i.sku,
  i.barcode,
  CAST(i.quantity AS FLOAT64)       AS quantity,
  CAST(i.cost_amount AS FLOAT64)    AS cost_amount,
  a._ingested_at
FROM ${ref("stg_haravan_inventory_adjustments")} a, UNNEST(a.line_items) AS i
